{
  "name": "claude-learners",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:a11y": "jest --testPathPattern a11y",
    "test:rls": "jest --testPathPattern rls --runInBand",
    "test:sync": "jest --testPathPattern sync --runInBand",
    "test:auth": "jest --testPathPattern auth-lifecycle --runInBand",
    "test:functions": "jest --testPathPattern functions --runInBand",
    "content:validate": "tsx content/scripts/validate.ts",
    "content:stats": "tsx content/scripts/stats.ts",
    "content:keypoints": "tsx content/scripts/build-keypoints.ts",
    "content:build": "tsx content/scripts/build-sqlite.ts",
    "content:bundle": "npm run content:build && npm run content:keypoints && tsx content/scripts/bundle-asset.ts",
    "content:calibrate": "tsx content/scripts/calibrate-dupes.ts",
    "supabase:start": "supabase start",
    "release:check": "node scripts/release-check.mjs",
    "listing:check": "node scripts/listing-check.mjs",
    "web:content": "tsx scripts/build-web-content.ts",
    "web:build": "npm run web:content && CL_WEB_EXPORT=1 CL_WEB_PRERENDER=1 EXPO_NO_WEB_SETUP=1 expo export --platform web --output-dir .web-prerender && CL_WEB_EXPORT=1 EXPO_NO_WEB_SETUP=1 expo export --platform web --output-dir dist && node scripts/web-postexport.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ui": "~57.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.3",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lottie-react-native": "~7.3.8",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "supabase": "2.84.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "tar": "7.5.21",
    "@react-native/jest-preset": "0.86.3",
    "@xmldom/xmldom@0.8": "0.8.15",
    "@xmldom/xmldom@0.9": "0.9.12",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@5": "5.0.9",
    "browserslist": "4.28.7",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
